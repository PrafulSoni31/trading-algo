//@version=5
strategy("Gap Strategy (Daily Indicators V2)", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// --- Inputs ---
// Timing Inputs
entryHour = input.int(9, "Entry Hour", minval=0, maxval=23)
entryMinute = input.int(20, "Entry Minute", minval=0, maxval=59)
exitHour = input.int(15, "Exit Hour", minval=0, maxval=23)
exitMinute = input.int(27, "Exit Minute", minval=0, maxval=59)

// Strategy Parameters (Daily)
rsiLen = input.int(10, "Daily RSI Length")
emaLen = input.int(21, "Daily EMA Length")
rsiOS = input.int(10, "RSI OverSold Level")
rsiOB = input.int(90, "RSI OverBought Level")

// Gap Logic Input - Set default to Full Gap as per user's latest request
gapType = input.string("Full Gap (Open vs High/Low)", "Gap Detection Type", options=["Full Gap (Open vs High/Low)", "Partial Gap (Open vs Close)"])

// Entry Filters (Set to false by default as they can block valid reversal trades)
buyBelowEMA = input.bool(false, "Long Entry must be below Daily EMA21")
sellAboveEMA = input.bool(false, "Short Entry must be above Daily EMA21")

useMonthlyFilters = input.bool(true, "Use Monthly Trend Filters")
monthlyEmaFastLen = input.int(5, "Monthly EMA Fast Length")
monthlyEmaSlowLen = input.int(13, "Monthly EMA Slow Length")

longSLMult = input.float(0.9985, "Long SL Multiplier (Prev Day Close * x)")
shortSLMult = input.float(1.0015, "Short SL Multiplier (Prev Day Close * x)")

// --- Timing ---
isTime(targetHour, targetMinute) =>
    timeframe.isdaily or (hour == targetHour and minute == targetMinute)

isEntryTime = isTime(entryHour, entryMinute)
isExitTime = isTime(exitHour, exitMinute)

// --- Data Fetching (Daily & Monthly) ---
var float todayOpen = na
if (ta.change(time("D")))
    todayOpen := open

get_macd_hist() =>
    [_, _, hist] = ta.macd(close, 12, 26, 9)
    hist

// Current Daily Indicators for Visualization
dEmaCurr = ta.ema(close, emaLen)
rsiOnEmaCurr = ta.rsi(dEmaCurr, rsiLen)

// request.security(..., "D", ...) with lookahead_off fetches the last CLOSED daily bar's data.
[dEmaPrev, dHighPrev, dLowPrev, dClosePrev, dRsiOnEmaPrev] = request.security(syminfo.tickerid, "D", [ta.ema(close, emaLen), high, low, close, ta.rsi(ta.ema(close, emaLen), rsiLen)], lookahead=barmerge.lookahead_off)

[mEmaFastPrev, mEmaSlowPrev, mMacdHistPrev, mClosePrev] = request.security(syminfo.tickerid, "M", [ta.ema(close, monthlyEmaFastLen), ta.ema(close, monthlyEmaSlowLen), get_macd_hist(), close], lookahead=barmerge.lookahead_off)

mTrendBull = mClosePrev > mEmaFastPrev and mEmaFastPrev > mEmaSlowPrev and mMacdHistPrev > 0
mTrendBear = mClosePrev < mEmaFastPrev and mEmaFastPrev < mEmaSlowPrev and mMacdHistPrev < 0

// --- Entry Conditions ---
effectiveOpen = timeframe.isdaily ? open : todayOpen

// Gap Logic based on Input
// Buy: current day open > previous day high (Full Gap)
// Sell: current day open < previous day low (Full Gap)
isGapUp = gapType == "Full Gap (Open vs High/Low)" ? effectiveOpen > dHighPrev : effectiveOpen > dClosePrev
isGapDown = gapType == "Full Gap (Open vs High/Low)" ? effectiveOpen < dLowPrev : effectiveOpen < dClosePrev

longCondition = isEntryTime
     and dRsiOnEmaPrev < rsiOS
     and isGapUp
     and (not buyBelowEMA or effectiveOpen < dEmaPrev)
     and (not useMonthlyFilters or mTrendBull)

shortCondition = isEntryTime
     and dRsiOnEmaPrev > rsiOB
     and isGapDown
     and (not sellAboveEMA or effectiveOpen > dEmaPrev)
     and (not useMonthlyFilters or mTrendBear)

// --- Strategy Execution ---
var float longStopPrice = na
var float shortStopPrice = na
var float entryPrice = na

// Reset logic: Only reset after position is fully closed
if (strategy.position_size[1] != 0 and strategy.position_size == 0)
    longStopPrice := na
    shortStopPrice := na
    entryPrice := na

// Entry Logic
if (longCondition)
    strategy.entry("Long", strategy.long)
    longStopPrice := dClosePrev * longSLMult
    entryPrice := close

if (shortCondition)
    strategy.entry("Short", strategy.short)
    shortStopPrice := dClosePrev * shortSLMult
    entryPrice := close

// --- Exit / SL Logic (Directionally Decoupled) ---
// Buy (Long) Exit Logic
if (strategy.position_size > 0)
    // Fixed Price SL for Long
    strategy.exit("Long SL", "Long", stop=longStopPrice, comment="Price SL")

    // EMA Exit for Long (Checked at configured Exit Time)
    if (isExitTime and dClosePrev > dEmaPrev and close < dEmaPrev)
        strategy.close("Long", comment="EMA Exit")

// Sell (Short) Exit Logic
if (strategy.position_size < 0)
    // Fixed Price SL for Short
    strategy.exit("Short SL", "Short", stop=shortStopPrice, comment="Price SL")

    // EMA Exit for Short (Checked at configured Exit Time)
    if (isExitTime and dClosePrev < dEmaPrev and close > dEmaPrev)
        strategy.close("Short", comment="EMA Exit")

// --- Visuals ---
emaToPlot = timeframe.isdaily ? dEmaCurr : dEmaPrev
plot(emaToPlot, "Daily EMA 21", color=color.new(color.white, 50), linewidth=2)

// Stop Loss & Entry plots (Only on Daily chart)
plot(timeframe.isdaily and strategy.position_size > 0 ? longStopPrice : na, "Long SL", color=color.red, style=plot.style_linebr, linewidth=2)
plot(timeframe.isdaily and strategy.position_size < 0 ? shortStopPrice : na, "Short SL", color=color.red, style=plot.style_linebr, linewidth=2)
plot(timeframe.isdaily and strategy.position_size != 0 ? entryPrice : na, "Entry Level", color=color.new(color.blue, 50), style=plot.style_linebr)

// Shapes (Prominent, Only on Daily chart)
plotshape(timeframe.isdaily and longCondition, "Long", shape.triangleup, location.belowbar, color.green, size=size.normal, text="LONG")
plotshape(timeframe.isdaily and shortCondition, "Short", shape.triangledown, location.abovebar, color.red, size=size.normal, text="SHORT")

// Exit Marker (Only on Daily chart)
exitDetected = strategy.position_size[1] != 0 and strategy.position_size == 0
plotshape(timeframe.isdaily and exitDetected, "Exit", shape.xcross, location.belowbar, color.orange, size=size.small, text="EXIT", offset=-1)

// Information Label (Only on Daily chart)
if (barstate.islast and timeframe.isdaily)
    var label infoLabel = label.new(bar_index, high, "", color=color.new(color.blue, 50), textcolor=color.white, style=label.style_label_left)

    changeAbs = close - dClosePrev
    changePct = (changeAbs / dClosePrev) * 100
    changeStr = str.tostring(changePct, "#.##") + "% (" + str.tostring(changeAbs, "#.##") + ")"

    labelText = "Timeframe: " + timeframe.period +
                 "\nGap Type: " + gapType +
                 "\nDaily RSI on EMA: " + str.tostring(dRsiOnEmaPrev, "#.##") +
                 "\nDaily EMA(21): " + str.tostring(emaToPlot, "#.##") +
                 "\nMonthly Trend: " + (mTrendBull ? "Bullish" : (mTrendBear ? "Bearish" : "Neutral")) +
                 "\nEntry: " + str.tostring(entryHour, "00") + ":" + str.tostring(entryMinute, "00") +
                 "\nExit: " + str.tostring(exitHour, "00") + ":" + str.tostring(exitMinute, "00")

    label.set_text(infoLabel, labelText)
    label.set_xy(infoLabel, bar_index + 1, close)
