//@version=5
strategy("Gap Strategy with RSI on EMA and Monthly Filters", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, process_orders_on_close=true)

// --- Inputs ---
// RSI on EMA Settings
rsiLen = input.int(10, "RSI Length", tooltip="Standard RSI length as per transcript.")
emaLen = input.int(21, "EMA Length", tooltip="21-day Exponential Moving Average.")
rsiOS = input.int(10, "RSI OverSold Level", tooltip="Entry threshold for long trades.")
rsiOB = input.int(90, "RSI OverBought Level", tooltip="Entry threshold for short trades.")

// Entry Filters
buyBelowEMA = input.bool(true, "Long Entry must be below EMA21", tooltip="Price must be below EMA21 at the time of gap up.")
sellBelowEMA = input.bool(true, "Short Entry must be below EMA21", tooltip="Price must be below EMA21 at the time of gap down.")

// Monthly Filters Settings
useMonthlyFilters = input.bool(true, "Use Monthly Trend Filters", tooltip="Filter entries based on the previous month's trend.")
monthlyEmaFastLen = input.int(5, "Monthly EMA Fast Length")
monthlyEmaSlowLen = input.int(13, "Monthly EMA Slow Length")

// Stop Loss Settings
longSLMult = input.float(0.9985, "Long SL Multiplier (Prev Close * x)", tooltip="Default is 0.15% below previous close.")
shortSLMult = input.float(1.0015, "Short SL Multiplier (Prev Close * x)", tooltip="Default is 0.15% above previous close.")

// --- Calculations ---
// Daily Indicators
emaVal = ta.ema(close, emaLen)
rsiOnEma = ta.rsi(emaVal, rsiLen)

// Monthly Indicators (Prev Month's Data to avoid lookahead)
get_macd_hist() =>
    [_, _, hist] = ta.macd(close, 12, 26, 9)
    hist

mEmaFast = request.security(syminfo.tickerid, "M", ta.ema(close, monthlyEmaFastLen)[1], lookahead=barmerge.lookahead_off)
mEmaSlow = request.security(syminfo.tickerid, "M", ta.ema(close, monthlyEmaSlowLen)[1], lookahead=barmerge.lookahead_off)
mMacdHist = request.security(syminfo.tickerid, "M", get_macd_hist()[1], lookahead=barmerge.lookahead_off)
mClose = request.security(syminfo.tickerid, "M", close[1], lookahead=barmerge.lookahead_off)

mTrendBull = mClose > mEmaFast and mEmaFast > mEmaSlow and mMacdHist > 0
mTrendBear = mClose < mEmaFast and mEmaFast < mEmaSlow and mMacdHist < 0

// Gap Detection
isGapUp = open > high[1]
isGapDown = open < low[1]

// --- Entry Conditions ---
longCondition = rsiOnEma[1] < rsiOS and isGapUp
if (buyBelowEMA)
    longCondition := longCondition and open < emaVal
if (useMonthlyFilters)
    longCondition := longCondition and mTrendBull

shortCondition = rsiOnEma[1] > rsiOB and isGapDown
if (sellBelowEMA)
    shortCondition := shortCondition and open < emaVal
if (useMonthlyFilters)
    shortCondition := shortCondition and mTrendBear

// --- Strategy Execution ---
var float longStopPrice = na
var float shortStopPrice = na
var bool hasClosedAboveEMA = false
var bool hasClosedBelowEMA = false

// Reset flags on new position
if (strategy.position_size == 0)
    hasClosedAboveEMA := false
    hasClosedBelowEMA := false
    longStopPrice := na
    shortStopPrice := na

// Entry
if (longCondition)
    strategy.entry("Long", strategy.long)
    longStopPrice := close[1] * longSLMult

if (shortCondition)
    strategy.entry("Short", strategy.short)
    shortStopPrice := close[1] * shortSLMult

// Phase 2 Logic: Check for first close on the correct side
if (strategy.position_size > 0)
    if (close > emaVal)
        hasClosedAboveEMA := true

    // Exit Phase 1: Price SL
    strategy.exit("Long SL", "Long", stop=longStopPrice, comment="Price SL")

    // Exit Phase 2: EMA Close
    if (hasClosedAboveEMA and close < emaVal)
        strategy.close("Long", comment="EMA Cross Exit")

if (strategy.position_size < 0)
    if (close < emaVal)
        hasClosedBelowEMA := true

    // Exit Phase 1: Price SL
    strategy.exit("Short SL", "Short", stop=shortStopPrice, comment="Price SL")

    // Exit Phase 2: EMA Close
    if (hasClosedBelowEMA and close > emaVal)
        strategy.close("Short", comment="EMA Cross Exit")

// --- Visuals ---
plot(emaVal, "EMA 21", color=color.white)
// Optional: plot RSI on a separate pane if needed, but here we just plot indicators on chart
plot(rsiOnEma, "RSI on EMA", color=color.yellow, display=display.none)

plotshape(longCondition, "Long Signal", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(shortCondition, "Short Signal", shape.triangledown, location.abovebar, color.red, size=size.small)

// Labels for transparency and user requested format
if (barstate.islast)
    var label infoLabel = label.new(bar_index, high, "", color=color.new(color.blue, 50), textcolor=color.white, style=label.style_label_left)

    changeAbs = close - close[1]
    changePct = (changeAbs / close[1]) * 100
    changeStr = str.tostring(changePct, "#.##") + "% (" + str.tostring(changeAbs, "#.##") + ")"

    labelText = "Current Change: " + changeStr +
                 "\nRSI on EMA: " + str.tostring(rsiOnEma, "#.##") +
                 "\nMonthly Trend Bull: " + str.tostring(mTrendBull) +
                 "\nMonthly Trend Bear: " + str.tostring(mTrendBear)

    label.set_text(infoLabel, labelText)
    label.set_xy(infoLabel, bar_index + 1, close)
