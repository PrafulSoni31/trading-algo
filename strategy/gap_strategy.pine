//@version=5
strategy("Gap Strategy (Daily & Intraday)", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// --- Inputs ---
rsiLen = input.int(10, "RSI Length")
emaLen = input.int(21, "EMA Length")
rsiOS = input.int(10, "RSI OverSold Level")
rsiOB = input.int(90, "RSI OverBought Level")

useMonthlyFilters = input.bool(true, "Use Monthly Trend Filters")
monthlyEmaFastLen = input.int(5, "Monthly EMA Fast Length")
monthlyEmaSlowLen = input.int(13, "Monthly EMA Slow Length")

longSLMult = input.float(0.9985, "Long SL Multiplier (Prev Day Close * x)")
shortSLMult = input.float(1.0015, "Short SL Multiplier (Prev Day Close * x)")

// --- Timing Robustness ---
// This function checks if the current bar contains or is the first bar after a target time.
// Optimized for 1m charts as per user's 09:20/15:27 requirement.
isTime(targetHour, targetMinute) =>
    timeframe.isdaily or (hour == targetHour and minute == targetMinute)

isEntryTime = isTime(9, 20)
isExitTime = isTime(15, 27)

// --- Data Fetching ---
var float todayOpen = na
if (ta.change(time("D")))
    todayOpen := open

get_macd_hist() =>
    [_, _, hist] = ta.macd(close, 12, 26, 9)
    hist

// Correct security calls: fetching last closed daily/monthly bar values.
[dEmaPrev, dHighPrev, dLowPrev, dClosePrev, dRsiOnEmaPrev] = request.security(syminfo.tickerid, "D", [ta.ema(close, emaLen), high, low, close, ta.rsi(ta.ema(close, emaLen), rsiLen)], lookahead=barmerge.lookahead_off)

[mEmaFastPrev, mEmaSlowPrev, mMacdHistPrev, mClosePrev] = request.security(syminfo.tickerid, "M", [ta.ema(close, monthlyEmaFastLen), ta.ema(close, monthlyEmaSlowLen), get_macd_hist(), close], lookahead=barmerge.lookahead_off)

mTrendBull = mClosePrev > mEmaFastPrev and mEmaFastPrev > mEmaSlowPrev and mMacdHistPrev > 0
mTrendBear = mClosePrev < mEmaFastPrev and mEmaFastPrev < mEmaSlowPrev and mMacdHistPrev < 0

// --- Conditions ---
effectiveOpen = timeframe.isdaily ? open : todayOpen
isGapUp = effectiveOpen > dHighPrev
isGapDown = effectiveOpen < dLowPrev

longCondition = isEntryTime and dRsiOnEmaPrev < rsiOS and isGapUp
shortCondition = isEntryTime and dRsiOnEmaPrev > rsiOB and isGapDown

if (useMonthlyFilters)
    longCondition := longCondition and mTrendBull
    shortCondition := shortCondition and mTrendBear

// --- Strategy Execution ---
var float longStopPrice = na
var float shortStopPrice = na

// Entry
if (longCondition)
    strategy.entry("Long", strategy.long)
    longStopPrice := dClosePrev * longSLMult

if (shortCondition)
    strategy.entry("Short", strategy.short)
    shortStopPrice := dClosePrev * shortSLMult

// Phase 1: Fixed Price SL (Active immediately)
if (strategy.position_size > 0)
    strategy.exit("Long SL", "Long", stop=longStopPrice, comment="Price SL")

if (strategy.position_size < 0)
    strategy.exit("Short SL", "Short", stop=shortStopPrice, comment="Price SL")

// Phase 2: EMA Exit Logic (Check at 15:27)
// Long Exit: Prev Day Close > EMA and Current Price < EMA
if (strategy.position_size > 0 and isExitTime)
    if (dClosePrev > dEmaPrev and close < dEmaPrev)
        strategy.close("Long", comment="EMA Exit 15:27")

// Short Exit: Prev Day Close < EMA and Current Price > EMA
if (strategy.position_size < 0 and isExitTime)
    if (dClosePrev < dEmaPrev and close > dEmaPrev)
        strategy.close("Short", comment="EMA Exit 15:27")

// Reset
if (strategy.position_size == 0)
    longStopPrice := na
    shortStopPrice := na

// --- Visuals ---
plot(dEmaPrev, "Prev Day EMA 21", color=color.white, linewidth=2)

plotshape(longCondition, "Long Signal", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(shortCondition, "Short Signal", shape.triangledown, location.abovebar, color.red, size=size.small)

// Labels
if (barstate.islast)
    var label infoLabel = label.new(bar_index, high, "", color=color.new(color.blue, 50), textcolor=color.white, style=label.style_label_left)

    changeAbs = close - dClosePrev
    changePct = (changeAbs / dClosePrev) * 100
    changeStr = str.tostring(changePct, "#.##") + "% (" + str.tostring(changeAbs, "#.##") + ")"

    labelText = "Chart: " + timeframe.period +
                 "\nGap Open: " + str.tostring(effectiveOpen, "#.##") +
                 "\nPrev High: " + str.tostring(dHighPrev, "#.##") +
                 "\nPrev RSI on EMA: " + str.tostring(dRsiOnEmaPrev, "#.##") +
                 "\nMonthly Trend: " + (mTrendBull ? "Bullish" : (mTrendBear ? "Bearish" : "Neutral")) +
                 "\nPrecision: Use 1m chart"

    label.set_text(infoLabel, labelText)
    label.set_xy(infoLabel, bar_index + 1, close)
